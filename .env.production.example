# Configure these in Vercel Project -> Settings -> Environment Variables.
# Use a managed MySQL database reachable from Vercel.
# URL-encode special characters in the username/password.
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@MYSQL_HOST:3306/shelfsignal?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
# Set to 1 only if you want the bundled sample dataset inserted into an empty database.
# The first cold start may take longer while this dataset is seeded.
SHELFSIGNAL_SEED_DEMO=1
