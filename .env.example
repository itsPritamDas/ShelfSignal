# Default: local SQLite database (created automatically in instance/shelfsignal.db)
DATABASE_URL=sqlite:///shelfsignal.db

# For MySQL, create a database named shelfsignal and use:
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/shelfsignal?charset=utf8mb4

SECRET_KEY=change-this-for-production
FLASK_DEBUG=1
